# Supabase environment variables (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase public keys (required for client-side fallback OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL - used for email redirect links (set to your deployed URL in production)
NEXT_PUBLIC_SITE_URL=https://carbon-credit-opal.vercel.app

# Notes:
# - Use .env.local in development and do not commit it to source control.
# - SUPABASE_SERVICE_ROLE_KEY is required for server-side admin auth operations.
# - Enable Google OAuth in your Supabase Dashboard → Authentication → Providers → Google.
# - Set redirect URL in Supabase to: https://your-domain.com/auth/callback
