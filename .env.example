# Supabase Database URL (Transaction Mode / Connection Pooling for app queries)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Supabase Database URL (Session Mode / Direct Connection for Prisma Migrations & Schema Sync)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Client SDK Configuration (Client-side & Server-side API access)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Signed httpOnly session JWT Secret
# Generate a strong 64-character random string in production
JWT_SECRET="e9a72b8d4c1f5a6b0c9e8d7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b"

# SMTP Server Configurations for Nodemailer (Email verification & Passwords)
# If left empty/unconfigured, emails auto-fallback to logging OTP codes in the server console!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Carbon Credit Support <noreply@carboncredit.com>"
